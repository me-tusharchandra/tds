# OpenRouter - single API for all LLMs (GPT-4o, Gemini, Perplexity)
OPENROUTER_API_KEY=sk-or-v1-...

# Exa AI - direct API for search + competitor discovery
EXA_API_KEY=...

# Supabase (Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_secret_...  # Use secret key for server-side

# CORS (optional) - comma-separated origins, defaults to http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
