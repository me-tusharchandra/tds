# OpenRouter - single API for all LLMs (GPT-4o, Gemini, Perplexity)
# Preferred when set. If empty, each engine falls back to its direct provider key below.
OPENROUTER_API_KEY=sk-or-v1-...

# Direct provider keys - used only when OPENROUTER_API_KEY is empty.
# OpenAI: paste your sk-... key (uses gpt-4o-search-preview with built-in web search).
OPENAI_API_KEY=
# Gemini (Google AI Studio): https://aistudio.google.com/apikey — free tier with grounding.
# Note: Perplexity has no free tier, so it has no native fallback and will be skipped
# when OPENROUTER_API_KEY is empty.
GEMINI_API_KEY=

# Exa AI - direct API for search + competitor discovery
EXA_API_KEY=...

# Supabase (Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_secret_...  # Use secret key for server-side

# CORS (optional) - comma-separated origins, defaults to http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
